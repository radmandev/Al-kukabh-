# Apache: send every request that isn't a real file to index.php
Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^ index.php [L,QSA]
</IfModule>

# long cache for versioned assets and brand images
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|jpe?g|png|webp|avif|gif|svg|mp4|webm|woff2?)$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>
</IfModule>

# large video uploads (only applies when PHP runs as an Apache module; otherwise see .user.ini)
<IfModule mod_php.c>
  php_value upload_max_filesize 200M
  php_value post_max_size 210M
  php_value max_execution_time 300
  php_value memory_limit 512M
</IfModule>
