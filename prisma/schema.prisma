// ponytail: SQLite for dev; switch provider to "postgresql" + DATABASE_URL for production.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// role: ADMIN (everything), EDITOR (catalog + content), CUSTOMER
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  phone        String?
  passwordHash String
  role         String   @default("CUSTOMER")
  createdAt    DateTime @default(now())
  orders       Order[]
}

model Media {
  id        String   @id @default(cuid())
  url       String
  kind      String // image | video
  mime      String
  width     Int?
  height    Int?
  size      Int
  altAr     String   @default("")
  altEn     String   @default("")
  posterId  String? // video thumbnail (another Media)
  createdAt DateTime @default(now())
  products  ProductMedia[]
}

model Category {
  id       String    @id @default(cuid())
  slug     String    @unique
  nameAr   String
  nameEn   String
  sort     Int       @default(0)
  products Product[]
}

model Collection {
  id          String   @id @default(cuid())
  slug        String   @unique
  nameAr      String
  nameEn      String
  descAr      String   @default("")
  descEn      String   @default("")
  coverId     String?
  coverMobileId String?
  sort        Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  products    Product[]
}

model Product {
  id           String   @id @default(cuid())
  slug         String   @unique
  sku          String   @unique
  nameAr       String
  nameEn       String
  descAr       String   @default("")
  descEn       String   @default("")
  fabricAr     String   @default("")
  fabricEn     String   @default("")
  detailsAr    String   @default("")
  detailsEn    String   @default("")
  careAr       String   @default("")
  careEn       String   @default("")
  price        Float
  salePrice    Float?
  sizes        String   @default("[]") // JSON string[]
  colors       String   @default("[]") // JSON {nameAr,nameEn,hex}[]
  stock        Int      @default(0)
  availability String   @default("in_stock") // in_stock | made_to_order | out_of_stock
  deliveryAr   String   @default("")
  deliveryEn   String   @default("")
  isNew        Boolean  @default(false)
  isFeatured   Boolean  @default(false)
  isLimited    Boolean  @default(false)
  isReady      Boolean  @default(false)
  published    Boolean  @default(true)
  seoTitle     String   @default("")
  seoDesc      String   @default("")
  categoryId   String?
  category     Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  collectionId String?
  collection   Collection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  media        ProductMedia[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// order of media per product; sort 0 = primary image
model ProductMedia {
  productId String
  mediaId   String
  sort      Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  media     Media   @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([productId, mediaId])
}

// Homepage block. type: hero | collections | products | occasions | ready | story | campaign | values | text
// data: JSON, shape depends on type (see src/lib/sections.ts)
model Section {
  id        String  @id @default(cuid())
  type      String
  sort      Int     @default(0)
  published Boolean @default(true)
  data      String  @default("{}")
}

model Discount {
  id        String    @id @default(cuid())
  code      String    @unique
  type      String    @default("percent") // percent | fixed
  value     Float
  minTotal  Float     @default(0)
  maxUses   Int?
  used      Int       @default(0)
  expiresAt DateTime?
  active    Boolean   @default(true)
}

model Order {
  id            String   @id @default(cuid())
  number        String   @unique
  userId        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  email         String
  name          String
  phone         String
  country       String
  city          String
  address       String
  notes         String   @default("")
  items         String // JSON snapshot of lines
  subtotal      Float
  discount      Float    @default(0)
  discountCode  String?
  shipping      Float    @default(0)
  total         Float
  currency      String
  paymentMethod String
  paymentStatus String   @default("pending") // pending | paid | failed | refunded
  status        String   @default("pending") // pending | confirmed | processing | cancelled | completed
  shipStatus    String   @default("unfulfilled") // unfulfilled | shipped | delivered | returned
  tracking      String   @default("")
  history       String   @default("[]") // JSON {at, note}[]
  createdAt     DateTime @default(now())
}

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

// single key/value store for store settings (JSON values)
model Setting {
  key   String @id
  value String
}
